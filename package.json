{
  "name": "harness-useful",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build && bun scripts/gen-csp.ts",
    "preview": "bun --bun vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "guard": "bun scripts/check-file-size.ts",
    "test": "bun test",
    "verify:build": "bun scripts/verify-build.ts && html-validate \"build/**/*.html\"",
    "lhci": "lhci autorun"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/enhanced-img": "^1.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.4",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "satori": "^0.63.2",
    "semantic-release": "^25.0.9",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
